{
  "identity": "BPG-LSTM: bounded physics-inspired sensor gating with stage-adaptive degradation constraints",
  "role": "proposed model of the accompanying manuscript; not a reconstruction of an external paper",
  "entrypoint": "src/train_condition_brdr_physics_gate_rul.py",
  "runner": "run.py",
  "dataset": "C-MAPSS FD001-FD004, RUL capped at 125",
  "seeds": [
    3407,
    2024,
    137,
    123,
    12345
  ],
  "protocol": {
    "epochs": 50,
    "batch_size": 256,
    "optimizer": "Adam, lr 0.001",
    "split_seed": 42,
    "validation": "20% engine-disjoint internal validation",
    "checkpoint": "best validation terminal-window RMSE; early stopping disabled",
    "gating_warmup_epochs": 5,
    "amp": false
  },
  "common_args": [
    "--split-seed",
    "42",
    "--batch-size",
    "256",
    "--max-rul",
    "125",
    "--early-stopping-patience",
    "0",
    "--selection-metric",
    "rmse",
    "--learnable-stage-prior",
    "--stage-prior-reg-weight",
    "0.001",
    "--late-stage-weight",
    "1.5",
    "--physics-sensor-gate",
    "--physics-sensor-gate-lstm-input",
    "--sensor-gate-condition-adaptive",
    "--sensor-gate-strength",
    "0.10",
    "--sensor-gate-max-strength",
    "0.20",
    "--sensor-gate-warmup-epochs",
    "5",
    "--skip-summary",
    "--condition-seed",
    "42"
  ],
  "subsets": {
    "FD001": {
      "window": 30,
      "hidden": 256,
      "layers": 1,
      "scaler": "global",
      "mono": 0.1,
      "smooth": 0.001,
      "failure": 0.1,
      "stage_prior": 0.5,
      "noise": 0.0,
      "dropout": 0.0
    },
    "FD002": {
      "window": 60,
      "hidden": 256,
      "layers": 1,
      "scaler": "condition",
      "mono": 0.1,
      "smooth": 0.01,
      "failure": 0.1,
      "stage_prior": 0.05,
      "noise": 0.0,
      "dropout": 0.0
    },
    "FD003": {
      "window": 30,
      "hidden": 256,
      "layers": 3,
      "scaler": "global",
      "mono": 0.025,
      "smooth": 0.0015,
      "failure": 0.025,
      "stage_prior": 0.75,
      "noise": 0.01,
      "dropout": 0.05
    },
    "FD004": {
      "window": 40,
      "hidden": 64,
      "layers": 1,
      "scaler": "condition",
      "mono": 0.1,
      "smooth": 0.01,
      "failure": 0.1,
      "stage_prior": 0.25,
      "noise": 0.005,
      "dropout": 0.0
    }
  },
  "notes": "Per-subset values are the executed configuration of the reported five-seed runs."
}
